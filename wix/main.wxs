<?xml version='1.0' encoding='windows-1252'?>
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='Aurum'
        UpgradeCode='4F8E9A12-3B4C-4D5E-8F9A-0B1C2D3E4F5A'
        Manufacturer='whittte169'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='A Rust powered Windows terminal.'
            Manufacturer='whittte169'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'/>

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='Aurum Installation'/>

        <Icon Id='AppIcon.ico' SourceFile='assets\icon.ico'/>
        <Property Id='ARPPRODUCTICON' Value='AppIcon.ico'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='ProgramFilesFolder' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='Aurum'>
                    
                    <Component Id='Path' Guid='7A8B9C0D-1E2F-4A3B-8C9D-0E1F2A3B4C5D' KeyPath='yes'>
                        <Environment
                            Id='PATH'
                            Name='PATH'
                            Value='[APPLICATIONFOLDER]'
                            Permanent='no'
                            Part='last'
                            Action='set'
                            System='yes'/>
                    </Component>

                    <Component Id='binary0' Guid='*'>
                        <File
                            Id='exe0'
                            Name='aurum-terminal.exe'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\aurum-terminal.exe'
                            KeyPath='yes'/>
                    </Component>

                </Directory>
            </Directory>

            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='Aurum'>
                    <Component Id='ApplicationShortcut' Guid='9E8D7C6B-5A4F-3E2D-1C0B-9A8F7E6D5C4B'>
                        <Shortcut Id='ApplicationStartMenuShortcut'
                            Name='Aurum'
                            Description='A Rust powered Windows terminal.'
                            Target='[#exe0]'
                            WorkingDirectory='APPLICATIONFOLDER'
                            Icon='AppIcon.ico'/>
                        <RemoveFolder Id='CleanUpShortCut' Directory='ApplicationProgramsFolder' On='uninstall'/>
                        <RegistryValue Root='HKCU' Key='Software\whittte169\Aurum' Name='installed' Type='integer' Value='1' KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs Aurum and assets.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>

            <ComponentRef Id='binary0'/>
            <ComponentRef Id='ApplicationShortcut'/>
            <ComponentGroupRef Id='AssetsGroup'/>

            <Feature
                Id='Environment'
                Title='PATH Environment Variable'
                Description='Add the install location to PATH.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>1</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>
        </UI>

        <WixVariable Id='WixUILicenseRtf' Value='wix\License.rtf'/>

    </Product>
</Wix>
